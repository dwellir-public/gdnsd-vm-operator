{
  "uid": "gdnsd-native",
  "title": "gdnsd native server metrics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "gdnsd"
  ],
  "description": "Server-wide totals include all zones and local health probes. Native stats do not distinguish n and x traffic.",
  "templating": {
    "list": [
      {
        "name": "prometheusds",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "lokids",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "juju_model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(gdnsd_scrape_success, juju_model)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "juju_model_uuid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(gdnsd_scrape_success, juju_model_uuid)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "juju_application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(gdnsd_scrape_success, juju_application)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "juju_unit",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(gdnsd_scrape_success, juju_unit)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Query rate by protocol",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (juju_model,protocol) (rate(gdnsd_requests_total{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}[$__rate_interval]))",
          "legendFormat": "{{juju_model}} {{protocol}} {{rcode}} {{operation}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Responses by code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (juju_model,rcode) (rate(gdnsd_responses_total{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}[$__rate_interval]))",
          "legendFormat": "{{juju_model}} {{protocol}} {{rcode}} {{operation}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Transport error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (juju_model,protocol,operation) (rate(gdnsd_transport_errors_total{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}[$__rate_interval]))",
          "legendFormat": "{{juju_model}} {{protocol}} {{rcode}} {{operation}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Daemon uptime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gdnsd_uptime_seconds{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}",
          "legendFormat": "{{juju_model}} {{protocol}} {{rcode}} {{operation}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Native stats collection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gdnsd_scrape_success{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}",
          "legendFormat": "{{juju_model}} {{protocol}} {{rcode}} {{operation}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Requests in selected range",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (juju_model,protocol) (increase(gdnsd_requests_total{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}[$__range]))",
          "legendFormat": "{{juju_model}} {{protocol}} {{rcode}} {{operation}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "gdnsd and exporter journal",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${lokids}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{juju_charm=\"gdnsd-vm\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true
      }
    }
  ]
}
